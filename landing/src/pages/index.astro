---
import Base from '../layouts/Base.astro';

const penalties = [
  { n: '5', what: 'Проезд на красный, не уступил дорогу, наезд на препятствие' },
  { n: '3', what: 'Пересёк сплошную, не включил поворотник, выехал на встречную' },
  { n: '1', what: 'Откат на подъёме больше 30 см, заглох, забыл ручник' },
];
---
<Base
  title="По зеркалам — тренажёр парковки и подготовки к экзамену в ГИБДД"
  description="Браузерный тренажёр манёвров: параллельная парковка по зеркалам, чувство габаритов, эстакада, экзаменационный маршрут со штрафными баллами по регламенту 2026. Бесплатно, без установки, работает на телефоне."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'По зеркалам',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    url: 'https://pozerkalam.space/play/',
    inLanguage: 'ru',
    description: 'Браузерный тренажёр манёвров: параллельная парковка по зеркалам, чувство габаритов, эстакада и экзаменационный маршрут со штрафными баллами по регламенту.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
  })} />

  <section class="hero" id="hero">
    <div class="hero-stage">
      <canvas class="hero-canvas" aria-hidden="true"></canvas>
      <div class="hero-scrim" aria-hidden="true"></div>
      <noscript>
        <img class="hero-fallback" src="/shots/parallel.webp" width="2000" height="1250"
             alt="Параллельная парковка в тренажёре: машина под 45 градусов к бордюру, на экране габаритная рамка и зазоры до соседних машин." />
      </noscript>

      <div class="hero-copy">
        <h1>Научись парковаться по зеркалам</h1>
        <p class="lead lede">Тренажёр манёвров в браузере: 32 уровня — от «почувствуй габариты»
          до экзаменационного маршрута с инспектором и штрафными баллами по регламенту.</p>
        <p class="hero-cta">
          <a class="btn lg" href="/play/">Начать тренировку</a>
        </p>
        <p class="hero-note">Бесплатно, без регистрации, работает на телефоне</p>
      </div>

      <div class="hero-coach" aria-hidden="true">
        <span class="hero-wheel"></span>
        <b data-step-title>Едешь вдоль ряда</b>
        <span data-step-act>Держи до машин 0,8 м и смотри в правое зеркало.</span>
      </div>
      <div class="hero-tel" aria-hidden="true">
        <div><span class="tel-k">до бордюра</span><span class="tel-v" data-tel="kerb">3,00</span><span class="tel-u">м</span></div>
        <div><span class="tel-k">до задней</span><span class="tel-v" data-tel="rear">3,00</span><span class="tel-u">м</span></div>
        <div><span class="tel-k">руль</span><span class="tel-v tel-w" data-tel="wheel">прямо</span></div>
        <div><span class="tel-k">передача</span><span class="tel-v" data-tel="gear">D</span></div>
      </div>
      <div class="hero-prog" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="scene">
    <div class="wrap">
      <h2>Зеркало ставят по ручке задней двери</h2>
      <div class="prose scene-body">
        <p>Три зеркала, каждое настраивается перетаскиванием. Полоска своего борта — четверть
          кадра, ручка задней двери — у внутреннего края чуть ниже середины. Так их
          выставляют в машине.</p>
        <p>Пресет «вниз на бордюр» опускает зеркало до заднего колеса и кромки бордюра.
          С ним прижимаются вплотную и не режут диски.</p>
      </div>
      <figure class="shot">
        <video class="clip" width="960" height="600" muted loop playsinline preload="none"
               poster="/clips/mirrors.webp"
               aria-label="Параллельная парковка из-за руля: в правом зеркале появляется угол задней машины, подсказка ведёт манёвр.">
          <source src="/clips/mirrors.mp4" type="video/mp4" />
        </video>
        <figcaption>Параллельная парковка из-за руля. В правом зеркале появляется угол задней
          машины — по нему и крутят руль.</figcaption>
      </figure>
    </div>
  </section>

  <section class="scene">
    <div class="wrap">
      <h2>Семь штрафных баллов — не сдал</h2>
      <div class="prose scene-body">
        <p>Маршрут собирается из девяти-десяти команд инспектора. Команда приходит заранее:
          «через 60 метров направо». Баллы считают по регламенту 2026.</p>
        <p>В протоколе — карта заезда с красными точками на ошибках. У каждой кнопка
          «отработать приём»: открывает то упражнение, где этот приём разбирают.</p>
      </div>

      <ul class="pen">
        {penalties.map((p) => (
          <li><span class="pen-n tel-v">{p.n}</span><span class="pen-w">{p.what}</span></li>
        ))}
      </ul>

      <div class="card stop scene-card">
        <p>Грубая ошибка отменяет попытку целиком, как в жизни. Касание бордюра записывают
          в протокол, но попытку оставляют: улица шириной 6,6 метра, новичок её заденет.</p>
      </div>

      <figure class="shot">
        <video class="clip" width="960" height="600" muted loop playsinline preload="none"
               poster="/clips/city.webp"
               aria-label="Кольцо в городе: машина стоит под знаком «уступи», пропускает едущего по кольцу и выходит на свой съезд.">
          <source src="/clips/city.mp4" type="video/mp4" />
        </video>
        <figcaption>Кольцо на общей карте. Уступаешь тем, кто уже на нём, съезд считаешь от въезда,
          перед своим включаешь правый.</figcaption>
      </figure>
    </div>
  </section>

  <section class="final">
    <div class="wrap">
      <h2>Открой и поезжай</h2>
      <p class="lead">32 уровня, экзаменационный маршрут, АКПП и МКПП. После первого
        открытия работает и без сети.</p>
      <p><a class="btn lg" href="/play/">Начать тренировку</a></p>
      <p class="final-alt">Сначала разобрать метод — <a href="/metodika/">три точки руля</a>.</p>
    </div>
  </section>
</Base>

<style>
  /* Герой: длинная прокрутка тянет один прикреплённый кадр — это и есть манёвр.
     Высота задаёт «сколько скролла» уходит на показ; 300vh = примерно три экрана. */
  .hero { height: 240vh; position: relative; padding: 0; }
  @media (prefers-reduced-motion: reduce) { .hero { height: auto; } }
  .hero-stage {
    position: sticky; top: 0; height: 100vh; height: 100svh;
    overflow: hidden; background: var(--asphalt);
  }
  .hero-canvas { position: absolute; inset: 0; display: block; }
  /* Сцена стоит на месте всю прокрутку, уходит только копия, поэтому читаемость
     даёт градиент. Его границы ставит скрипт по реальному низу блока копии
     (--scrim-a/b): проценты от высоты расходились с текстом на низких экранах. */
  .hero-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg,
      var(--asphalt) 0 var(--scrim-a, 30%),
      rgba(11,15,20,.55) calc(var(--scrim-a, 30%) + (var(--scrim-b, 60%) - var(--scrim-a, 30%)) * 0.55),
      rgba(11,15,20,0) var(--scrim-b, 60%));
    transition: opacity .55s ease;
  }
  .hero.open .hero-scrim { opacity: 0; }
  .hero-fallback { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }

  /* Заголовок стоит по центру, как афиша, и уходит один раз — дальше кадром
     распоряжается сцена. Остальная страница остаётся по левой оси. */
  .hero-copy {
    position: absolute; left: 50%; transform: translateX(-50%);
    top: clamp(44px, 8.5vh, 104px); width: min(100% - var(--gut) * 2, 900px);
    text-align: center; z-index: 2;
    transition: opacity .5s ease, transform .5s ease;
  }
  .hero-copy h1 { font-size: clamp(2.05rem, 4.6vw, 4.1rem); margin: 0 auto .5em; max-width: 17ch; }
  .hero-copy .lead { margin: 0 auto 1.9em; }
  .hero-copy .lede { max-width: 46ch; }
  .hero-cta { margin: 0 0 .8em; }
  .hero-note { color: var(--faint); font-size: .88rem; margin: 0; }
  .hero.open .hero-copy {
    opacity: 0; transform: translate(-50%, -22px); pointer-events: none; visibility: hidden;
    transition: opacity .5s ease, transform .5s ease, visibility 0s linear .5s;
  }

  /* HUD героя занимает те же места, что в игре: карточка сверху по центру,
     полоса телеметрии внизу слева, зеркало (его рисует canvas) внизу справа. */
  .hero-coach, .hero-tel {
    position: absolute; z-index: 2; opacity: 0;
    transition: opacity .45s ease, transform .45s ease;
  }
  .hero-coach { transform: translate(-50%, -10px); }
  .hero-tel { transform: translateY(10px); }
  .hero.open .hero-coach { opacity: 1; transform: translate(-50%, 0); }
  .hero.open .hero-tel { opacity: 1; transform: none; }

  .hero-coach {
    left: 50%; top: calc(58px + clamp(14px, 2.2vh, 26px)); width: min(100% - var(--gut) * 2, 620px);
    background: var(--glass); border: 1px solid rgba(120,190,255,.30);
    border-left: 4px solid rgba(120,190,255,.7); border-radius: 0 10px 10px 0;
    padding: 10px 16px; font-size: .93rem; line-height: 1.45; color: #e2f2ff; text-align: left;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .hero-coach b { font-weight: 650; }
  .hero-coach b::after { content: '.'; margin-right: .32em; }
  .hero-coach span[data-step-act] { color: #b9d6ee; }
  .hero-wheel {
    width: 15px; height: 15px; border: 2px solid var(--beam); border-radius: 50%;
    display: inline-block; position: relative; vertical-align: -2px; margin-right: 8px;
    transition: transform .3s ease;
  }
  .hero-wheel::before {
    content: ''; position: absolute; left: 50%; top: 50%; width: 2px; height: 7px;
    background: var(--beam); transform: translate(-50%, -100%);
  }

  .hero-tel { left: var(--gut); bottom: clamp(22px, 3.5vh, 38px); display: flex; flex-wrap: wrap; gap: 8px; }
  .hero-tel > div {
    background: var(--glass); border: 1px solid var(--edge); border-radius: 8px;
    padding: 6px 11px; display: flex; align-items: baseline; gap: 6px;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .hero-tel .tel-v { font-size: .95rem; color: #fff; }
  .hero-tel .tel-w { font-size: .84rem; font-weight: 550; }
  .hero-tel .tel-u { color: var(--faint); font-size: .78rem; }

  .hero-prog { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: rgba(255,255,255,.06); z-index: 3; }
  .hero-prog i { display: block; height: 100%; background: var(--beam); transform-origin: 0 50%; transform: scaleX(0); }

  /* Низкое окно ноутбука: заголовок и лид ужимаются, иначе кнопка уходит за край. */
  @media (min-width: 900px) and (max-height: 780px) {
    .hero-copy { top: clamp(40px, 7vh, 78px); }
    .hero-copy h1 { font-size: clamp(1.9rem, 3.5vw, 2.9rem); }
    .hero-copy .lead { font-size: 1.02rem; margin-bottom: 1.4em; }
    .btn.lg { font-size: 1rem; padding: .82em 1.7em; }
  }

  @media (max-width: 899px) {
    .hero-copy { top: clamp(40px, 7vh, 88px); }
    .hero-copy h1 { max-width: 14ch; }
    .hero-coach { top: calc(58px + 12px); font-size: .87rem; padding: 9px 13px; }
    .hero-tel { left: var(--gut); right: var(--gut); bottom: clamp(14px, 2.4vh, 26px); gap: 6px; }
    .hero-tel > div { flex: 1 1 0; }
    .hero-tel > div:nth-child(n+3) { display: none; }
  }

  /* Сцены: заголовок у той же левой оси, что и всё остальное; текст, затем
     доказательство кадром. Никаких въездов по скроллу — движение только в герое. */
  .scene h2 { max-width: 20ch; }
  .scene-body { margin-top: clamp(20px, 2.6vw, 32px); color: var(--mute); }

  @media (min-width: 1000px) {
    .scene .wrap {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(36px, 5vw, 84px);
      align-items: start;
    }
    .scene h2 { grid-column: 1; }
    .scene .scene-body { grid-column: 2; margin-top: .35em; }
    /* список баллов и карточка стоят на той же оси, что и текст: во всю ширину они
       обрывались на 64ch и линейки уезжали в пустоту правее текста */
    .scene .pen,
    .scene .scene-card { grid-column: 2; }
    .scene .shot { grid-column: 1 / -1; }
  }

  .scene-card { margin-top: clamp(20px, 2.4vw, 30px); max-width: 60ch; }
  .scene-card.wide { max-width: 68ch; }
  .scene-card p { color: var(--mute); }

  .pen { list-style: none; padding: 0; margin: clamp(22px, 2.6vw, 32px) 0 0; max-width: 60ch; }
  .pen li {
    display: grid; grid-template-columns: 2.2ch 1fr; column-gap: 18px;
    align-items: baseline; padding: 14px 0; border-top: 1px solid var(--edge);
  }
  .pen li:last-child { border-bottom: 1px solid var(--edge); }
  .pen-n { font-size: 1.5rem; color: var(--stop); letter-spacing: -.03em; }
  .pen-w { color: var(--mute); font-size: .98rem; }

  .shot { margin: clamp(34px, 4.6vw, 60px) 0 0; }
  .shot img,
  .shot video { border-radius: 14px; border: 1px solid var(--edge); background: var(--asphalt-2); }
  .shot video { display: block; width: 100%; height: auto; }
  .shot figcaption { margin-top: 12px; color: var(--faint); font-size: .87rem; max-width: 62ch; }

  .final { text-align: center; padding-bottom: clamp(20px, 4vw, 48px); }
  .final h2 { max-width: 22ch; margin: 0 auto .5em; }
  .final .lead { max-width: 46ch; margin: 0 auto 2em; }
  .final-alt { margin-top: 22px; color: var(--faint); font-size: .92rem; }
</style>

<script>
  import { mount } from '../scripts/park.js';
  const hero = document.getElementById('hero');
  if (hero) mount(hero);

  /* Ролики грузятся, только когда доезжаешь до них, и останавливаются за экраном:
     preload="none" плюс IntersectionObserver — страница открывается без их веса. */
  const clips = document.querySelectorAll('video.clip');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (clips.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((rows) => {
      for (const r of rows) {
        const v = r.target;
        if (r.isIntersecting) { v.play().catch(() => {}); }
        else v.pause();
      }
    }, { rootMargin: '120px 0px', threshold: 0.25 });
    for (const v of clips) { v.preload = 'auto'; io.observe(v); }
  }
</script>
