---
import Base from '../layouts/Base.astro';

const penalties = [
  { n: '5', what: 'Проезд на красный, не уступил дорогу, наезд на препятствие' },
  { n: '3', what: 'Пересёк сплошную, не включил поворотник, выехал на встречную' },
  { n: '1', what: 'Откат на подъёме больше 30 см, заглох, забыл ручник' },
];

const groups = [
  { n: '1–13', t: 'Двор. ', d: 'Параллельная парковка справа и слева, задним ходом в карман, разворот в три приёма, змейка, гараж.' },
  { n: '14–19', t: 'Габариты. ', d: 'Встаёшь там, где, по-твоему, осталось 20 сантиметров. Цифра зазора закрыта, пока не остановишься.' },
  { n: '20–22', t: 'Площадка. ', d: 'Эстакада с ручником и откатом не больше 30 сантиметров, задний ход по коридору, остановка у тротуара.' },
  { n: '23–31', t: 'Город. ', d: 'Светофоры, переходы, трамвайные пути, кольцо, сплошная, знаки приоритета. Грубая ошибка отменяет заезд.' },
  { n: '32', t: 'Экзамен. ', d: 'Девять-десять команд инспектора, три разных маршрута.' },
];

const who = [
  {
    h: 'Через две недели город',
    p: 'Занятие раз в неделю, а манёвр надо повторить десять раз. Параллельная парковка справа и слева — уровни 1 и 2: подсказка называет точку поворота руля и признак, что ты в неё попал.',
  },
  {
    h: 'Права есть, во двор не заезжаю',
    p: 'Уровни 14–19 про зазор: сначала оцениваешь на глаз, потом смотришь, на сколько ошибся. Цифра открывается, когда остановишься.',
  },
  {
    h: 'Год не садился за руль',
    p: 'Начни со двора: тринадцать уровней открыты сразу, заезд можно повторять сколько нужно.',
  },
];

const feats = [
  { t: 'Показ', d: 'Машина проедет уровень сама и объяснит каждый приём: первый — за 25 секунд.' },
  { t: 'Габариты на асфальте', d: 'Машина обведена по контуру, ближний угол краснеет с расстоянием. Клавиша B убирает подсказки по одной.' },
  { t: 'Зазоры со всех сторон', d: 'Спереди, сзади, слева, справа — до сантиметра. Рядом 5,4 и 8,2 метра, которые из-за руля не видно.' },
  { t: 'Три зеркала', d: 'Салонное и два боковых, каждое настраивается пальцем. Три учебных положения.' },
  { t: 'Вид из-за руля', d: 'Клавиша V сажает за руль, C возвращает камеру за машину.' },
  { t: 'Линия проезда', d: 'Клавиша G рисует на асфальте траекторию образцового заезда.' },
  { t: 'Автомат и механика', d: 'Коробка меняется одной кнопкой. На механике машина глохнет.' },
  { t: 'Своя площадка', d: 'Редактор: свой двор из стен, машин и конусов. Пять слотов.' },
  { t: 'На телефоне', d: 'Экранные кнопки вместо клавиш, остальное — в меню ≡.' },
];
---
<Base
  title="По зеркалам — тренажёр парковки и подготовки к экзамену в ГИБДД"
  description="Браузерный тренажёр манёвров: параллельная парковка по зеркалам, чувство габаритов, эстакада, экзаменационный маршрут со штрафными баллами по регламенту 2026. Бесплатно, без установки, работает на телефоне."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'По зеркалам',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    url: 'https://pozerkalam.space/play/',
    inLanguage: 'ru',
    description: 'Браузерный тренажёр манёвров: параллельная парковка по зеркалам, чувство габаритов, эстакада и экзаменационный маршрут со штрафными баллами по регламенту.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
  })} />

  <section class="hero" id="hero">
    <div class="hero-stage">
      <canvas class="hero-canvas" aria-hidden="true"></canvas>
      <div class="hero-scrim" aria-hidden="true"></div>
      <noscript>
        <img class="hero-fallback" src="/shots/parallel.webp" width="2000" height="1250"
             alt="Параллельная парковка в тренажёре: машина под 45 градусов к бордюру, на экране габаритная рамка и зазоры до соседних машин." />
      </noscript>

      <div class="hero-copy">
        <h1>Научись парковаться по зеркалам</h1>
        <p class="lead lede">Тренажёр манёвров в браузере: 32 уровня — от «почувствуй габариты»
          до экзамена с инспектором и штрафными баллами.</p>
        <p class="hero-cta">
          <a class="btn lg" href="/play/">Начать тренировку</a>
        </p>
        <p class="hero-note">Бесплатно, без регистрации. Первый уровень — параллельная парковка справа.</p>
      </div>

      <div class="hero-coach" aria-hidden="true">
        <span class="hero-wheel"></span>
        <b data-step-title>Зеркала вровень</b>
        <span data-step-act>Едешь вдоль ряда в 0,8 м: твоё зеркало против его зеркала, твоя корма — на полметра позади его кормы. Стоп.</span>
      </div>
      <div class="hero-tel" aria-hidden="true">
        <div><span class="tel-k">до бордюра</span><span class="tel-v" data-tel="kerb">3,00</span><span class="tel-u">м</span></div>
        <div><span class="tel-k">до задней</span><span class="tel-v" data-tel="rear">3,00</span><span class="tel-u">м</span></div>
        <div><span class="tel-k">руль</span><span class="tel-v tel-w" data-tel="wheel">прямо</span></div>
        <div><span class="tel-k">передача</span><span class="tel-v" data-tel="gear">D</span></div>
      </div>
      <div class="hero-prog" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="scene">
    <div class="wrap">
      <h2>Три ситуации, где не хватает практики</h2>
      <div class="prose scene-body">
        <p>Начинай с той, которая твоя: все уровни открыты сразу.</p>
      </div>

      <div class="cols">
        {who.map((w) => (
          <div><h3>{w.h}</h3><p>{w.p}</p></div>
        ))}
      </div>

      <div class="card who-card">
        <p>Все три — мои. Часов практики в автошколе мне не хватило. Повторять манёвр между
          занятиями было негде.</p>
      </div>
    </div>
  </section>

  <section class="scene">
    <div class="wrap">
      <h2>32 уровня: от двора до экзамена</h2>
      <div class="scene-col">
        <div class="prose scene-body">
          <p>Все открыты сразу — начинай с того, что не выходит. Уровень помнит заезды,
            чистые проезды и лучшее время, упражнения на габариты — лучшую точность в
            сантиметрах. Экран выбора считает готовность к экзамену: сколько из семнадцати
            экзаменационных уровней пройдено чисто, и называет те, что остались.</p>
        </div>

        <dl class="groups">
          {groups.map((g) => (
            <div><dt>{g.n}</dt><dd><b>{g.t}</b>{g.d}</dd></div>
          ))}
        </dl>
      </div>

      <figure class="shot">
        <img src="/shots/drill.webp" width="2000" height="1250" loading="lazy" decoding="async"
             alt="Упражнение на габариты: машина у стены, показание зазора спереди закрыто знаком вопроса." />
        <figcaption>Упражнение на габариты: зазор спереди закрыт, пока не остановишься.</figcaption>
      </figure>
    </div>
  </section>

  <section class="scene">
    <div class="wrap">
      <h2>Подсказка ведёт манёвр шаг за шагом</h2>
      <div class="prose scene-body">
        <p>Карточка сверху называет одно действие и признак, что оно закончено: «полный руль
          вправо, медленно назад — пока угол к цели не дойдёт до 45°». Рядом счётчик:
          цель 45°, сейчас 12°.</p>
      </div>

      <div class="feats">
        {feats.map((f) => (
          <div><h3>{f.t}</h3><p>{f.d}</p></div>
        ))}
      </div>

      <figure class="shot">
        <video class="clip" width="960" height="600" muted loop playsinline preload="none"
               poster="/clips/mirrors.webp"
               aria-label="Параллельная парковка из-за руля: подсказка ведёт манёвр, в правом зеркале появляется угол задней машины.">
          <source src="/clips/mirrors.mp4" type="video/mp4" />
        </video>
        <figcaption>Вид из-за руля: подсказка сверху, зеркала по краям, зазоры снизу.</figcaption>
      </figure>
    </div>
  </section>

  <section class="scene">
    <div class="wrap">
      <h2>Семь штрафных баллов — не сдал</h2>
      <div class="scene-col">
        <div class="prose scene-body">
          <p>Команда инспектора приходит заранее: «через 60 метров направо». Баллы считают по
            регламенту 2026, в протоколе — карта заезда с красными точками на ошибках и
            кнопкой «отработать приём» у каждой.</p>
        </div>

        <ul class="pen">
          {penalties.map((p) => (
            <li><span class="pen-n tel-v">{p.n}</span><span class="pen-w">{p.what}</span></li>
          ))}
        </ul>

        <div class="card stop scene-card">
          <p>Грубая ошибка отменяет попытку целиком, как в жизни. Касание бордюра пишут в
            протокол, но попытку оставляют: улица 6,6 метра, новичок её заденет.</p>
        </div>
      </div>

      <figure class="shot">
        <video class="clip" width="960" height="600" muted loop playsinline preload="none"
               poster="/clips/city.webp"
               aria-label="Кольцо в городе: машина стоит под знаком «уступи», пропускает едущего по кольцу и выходит на свой съезд.">
          <source src="/clips/city.mp4" type="video/mp4" />
        </video>
        <figcaption>Кольцо: уступаешь тем, кто уже на нём, перед своим съездом — правый.</figcaption>
      </figure>
    </div>
  </section>

  <section class="final">
    <div class="wrap">
      <h2>Открой и поезжай</h2>
      <p class="lead">32 уровня, экзаменационный маршрут, АКПП и МКПП. После первого
        открытия работает и без сети.</p>
      <p><a class="btn lg" href="/play/">Начать тренировку</a></p>

      <div class="card final-why">
        <h3>Я написал это для себя</h3>
        <p>С одного объяснения у меня не получалось. Манёвр показывали раз за занятие, а
          повторить его десять раз было негде — к городу я подошёл, сделав параллельную
          парковку дважды. Такого приложения на русском не нашёл, поэтому написал сам.
          Здесь заезд повторяется сколько нужно: на занятиях, перед экзаменом и после прав.</p>
      </div>
      <p class="final-alt">Сначала разобрать метод — <a href="/metodika/">три точки руля</a>.
        Для автошколы — <a href="/avtoshkolam/">условия пилота</a>.</p>
    </div>
  </section>
</Base>

<style>
  /* Герой: прокрутка тянет один прикреплённый кадр — это и есть манёвр. Высота задаёт,
     сколько скролла уходит на показ: прокрутка сцены = высота − 100vh (`park.js`, span).
     Копия уходит на 10 % прокрутки, поэтому высота и длина ленты реплик — связанная пара,
     и считается она в пикселях прокрутки на реплику (порог читаемости — 110 px на десктопе
     и 90 px на телефоне, примерно один щелчок колеса; замер — tools/hero-tape.mjs). Было
     240vh: 1260 px прокрутки на 1440×900 и 1,4 экрана без единой строки текста — кто не
     понял с первого экрана, уходил здесь. 185vh даёт 765 px, из них 689 px молчащих
     (0,77 экрана) и по 111 px на каждую из шести реплик. Короче сделать нельзя, не выкинув
     реплику: на 150vh их достаётся по 90 px, на 175vh — по 98 px. */
  .hero { height: 185vh; position: relative; padding: 0; }
  @media (prefers-reduced-motion: reduce) { .hero { height: auto; } }
  .hero-stage {
    position: sticky; top: 0; height: 100vh; height: 100svh;
    overflow: hidden; background: var(--asphalt);
  }
  .hero-canvas { position: absolute; inset: 0; display: block; }
  /* Сцена стоит на месте всю прокрутку, уходит только копия, поэтому читаемость
     даёт градиент. Его границы ставит скрипт по реальному низу блока копии
     (--scrim-a/b): проценты от высоты расходились с текстом на низких экранах. */
  .hero-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg,
      var(--asphalt) 0 var(--scrim-a, 30%),
      rgba(11,15,20,.55) calc(var(--scrim-a, 30%) + (var(--scrim-b, 60%) - var(--scrim-a, 30%)) * 0.55),
      rgba(11,15,20,0) var(--scrim-b, 60%));
    transition: opacity .55s ease;
  }
  .hero.open .hero-scrim { opacity: 0; }
  .hero-fallback { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }

  /* Заголовок стоит по центру, как афиша, и уходит один раз — дальше кадром
     распоряжается сцена. Остальная страница остаётся по левой оси. */
  .hero-copy {
    position: absolute; left: 50%; transform: translateX(-50%);
    top: clamp(44px, 8.5vh, 104px); width: min(100% - var(--gut) * 2, 900px);
    text-align: center; z-index: 2;
    transition: opacity .5s ease, transform .5s ease;
  }
  .hero-copy h1 { font-size: clamp(2.05rem, 4.6vw, 4.1rem); margin: 0 auto .5em; max-width: 17ch; }
  .hero-copy .lead { margin: 0 auto 1.9em; }
  .hero-copy .lede { max-width: 46ch; }
  .hero-cta { margin: 0 0 .8em; }
  .hero-note { color: var(--faint); font-size: .88rem; margin: 0; }
  .hero.open .hero-copy {
    opacity: 0; transform: translate(-50%, -22px); pointer-events: none; visibility: hidden;
    transition: opacity .5s ease, transform .5s ease, visibility 0s linear .5s;
  }

  /* HUD героя занимает те же места, что в игре: карточка сверху по центру,
     полоса телеметрии внизу слева, зеркало (его рисует canvas) внизу справа. */
  .hero-coach, .hero-tel {
    position: absolute; z-index: 2; opacity: 0;
    transition: opacity .45s ease, transform .45s ease;
  }
  .hero-coach { transform: translate(-50%, -10px); }
  .hero-tel { transform: translateY(10px); }
  .hero.open .hero-coach { opacity: 1; transform: translate(-50%, 0); }
  .hero.open .hero-tel { opacity: 1; transform: none; }

  .hero-coach {
    left: 50%; top: calc(58px + clamp(14px, 2.2vh, 26px)); width: min(100% - var(--gut) * 2, 620px);
    background: var(--glass); border: 1px solid rgba(120,190,255,.30);
    border-left: 4px solid rgba(120,190,255,.7); border-radius: 0 10px 10px 0;
    padding: 10px 16px; font-size: .93rem; line-height: 1.45; color: #e2f2ff; text-align: left;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .hero-coach b { font-weight: 650; }
  .hero-coach b::after { content: '.'; margin-right: .32em; }
  .hero-coach span[data-step-act] { color: #b9d6ee; }
  .hero-wheel {
    width: 15px; height: 15px; border: 2px solid var(--beam); border-radius: 50%;
    display: inline-block; position: relative; vertical-align: -2px; margin-right: 8px;
    transition: transform .3s ease;
  }
  .hero-wheel::before {
    content: ''; position: absolute; left: 50%; top: 50%; width: 2px; height: 7px;
    background: var(--beam); transform: translate(-50%, -100%);
  }

  .hero-tel { left: var(--gut); bottom: clamp(22px, 3.5vh, 38px); display: flex; flex-wrap: wrap; gap: 8px; }
  .hero-tel > div {
    background: var(--glass); border: 1px solid var(--edge); border-radius: 8px;
    padding: 6px 11px; display: flex; align-items: baseline; gap: 6px;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .hero-tel .tel-v { font-size: .95rem; color: #fff; }
  .hero-tel .tel-w { font-size: .84rem; font-weight: 550; }
  .hero-tel .tel-u { color: var(--faint); font-size: .78rem; }

  .hero-prog { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: rgba(255,255,255,.06); z-index: 3; }
  .hero-prog i { display: block; height: 100%; background: var(--beam); transform-origin: 0 50%; transform: scaleX(0); }

  /* Низкое окно ноутбука: заголовок и лид ужимаются, иначе кнопка уходит за край. */
  @media (min-width: 900px) and (max-height: 780px) {
    .hero-copy { top: clamp(40px, 7vh, 78px); }
    .hero-copy h1 { font-size: clamp(1.9rem, 3.5vw, 2.9rem); }
    .hero-copy .lead { font-size: 1.02rem; margin-bottom: 1.4em; }
    .btn.lg { font-size: 1rem; padding: .82em 1.7em; }
  }

  @media (max-width: 899px) {
    .hero-copy { top: clamp(40px, 7vh, 88px); }
    .hero-copy h1 { max-width: 14ch; }
    .hero-coach { top: calc(58px + 12px); font-size: .87rem; padding: 9px 13px; }
    .hero-tel { left: var(--gut); right: var(--gut); bottom: clamp(14px, 2.4vh, 26px); gap: 6px; }
    .hero-tel > div { flex: 1 1 0; }
    .hero-tel > div:nth-child(n+3) { display: none; }
  }

  /* Сцены: заголовок у той же левой оси, что и всё остальное; текст, затем
     доказательство кадром. Никаких въездов по скроллу — движение только в герое. */
  .scene h2 { max-width: 20ch; }
  .scene-body { margin-top: clamp(20px, 2.6vw, 32px); color: var(--mute); }

  @media (min-width: 1000px) {
    .scene .wrap {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(36px, 5vw, 84px);
      align-items: start;
    }
    .scene h2 { grid-column: 1; }
    .scene .scene-body { grid-column: 2; margin-top: .35em; }
    /* Правая колонка — ОДИН элемент сетки. Списком по отдельности они попадали в
       следующий ряд, который начинается под нижним краем трёхстрочного заголовка,
       и между текстом и списком зияло 200 px пустоты. */
    .scene .scene-col { grid-column: 2; }
    .scene .feats,
    .scene .cols,
    .scene .who-card,
    .scene .shot { grid-column: 1 / -1; }
  }

  /* Разбивка уровней: слева номера, справа что именно там отрабатывают. */
  .groups { margin: clamp(24px, 3vw, 38px) 0 0; }
  .groups > div {
    display: grid; grid-template-columns: 6.5ch 1fr; column-gap: clamp(16px, 2vw, 28px);
    padding: 17px 0; border-top: 1px solid var(--edge);
  }
  .groups > div:last-child { border-bottom: 1px solid var(--edge); }
  .groups dt { font-size: 1.06rem; font-weight: 700; color: var(--kerb); letter-spacing: -.02em; }
  .groups dd { margin: 0; color: var(--mute); font-size: .96rem; }
  /* На телефоне колонка номеров съедает треть строки — ставим номер над описанием. */
  @media (max-width: 560px) {
    .groups > div { grid-template-columns: 1fr; row-gap: 5px; }
  }

  /* Возможности: короткие карточки в три колонки, на телефоне — в одну. */
  .feats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(20px, 2.4vw, 30px) clamp(22px, 3vw, 44px);
    margin: clamp(26px, 3.2vw, 44px) 0 0;
  }
  .feats > div { border-top: 1px solid var(--edge); padding-top: 15px; }
  .feats h3 { font-size: 1.04rem; font-weight: 700; margin-bottom: 8px; }
  .feats p { margin: 0; color: var(--mute); font-size: .94rem; }

  /* Три ситуации и подпись автора — та же сетка, что у остальных сцен: заголовок слева,
     доказательство во всю ширину. `.cols` и карточка идут отдельными элементами сетки, иначе
     на телефоне подпись «все три — мои» встаёт ПЕРЕД тремя ситуациями, к которым отсылает. */
  .who-card { margin: clamp(22px, 2.8vw, 34px) 0 0; max-width: 62ch; }

  .scene-card { margin-top: clamp(20px, 2.4vw, 30px); max-width: 60ch; }
  .scene-card.wide { max-width: 68ch; }
  .scene-card p { color: var(--mute); }

  .pen { list-style: none; padding: 0; margin: clamp(22px, 2.6vw, 32px) 0 0; max-width: 60ch; }
  .pen li {
    display: grid; grid-template-columns: 2.2ch 1fr; column-gap: 18px;
    align-items: baseline; padding: 14px 0; border-top: 1px solid var(--edge);
  }
  .pen li:last-child { border-bottom: 1px solid var(--edge); }
  .pen-n { font-size: 1.5rem; color: var(--stop); letter-spacing: -.03em; }
  .pen-w { color: var(--mute); font-size: .98rem; }

  .shot { margin: clamp(34px, 4.6vw, 60px) 0 0; }
  .shot img,
  .shot video { border-radius: 14px; border: 1px solid var(--edge); background: var(--asphalt-2); }
  .shot video { display: block; width: 100%; height: auto; }
  .shot figcaption { margin-top: 12px; color: var(--faint); font-size: .87rem; max-width: 62ch; }

  .final { text-align: center; padding-bottom: clamp(20px, 4vw, 48px); }
  .final h2 { max-width: 22ch; margin: 0 auto .5em; }
  .final .lead { max-width: 46ch; margin: 0 auto 2em; }
  /* Подпись автора внутри центрированной финальной секции читается как текст, а не как
     лозунг, поэтому выравнивание возвращается по левому краю. */
  .final-why { max-width: 62ch; margin: clamp(30px, 4vw, 46px) auto 0; text-align: left; }
  .final-why h3 { margin-bottom: .5em; }
  .final-why p { color: var(--mute); margin: 0; }

  .final-alt { margin-top: 22px; color: var(--faint); font-size: .92rem; }

  /* Блок стоит последним в файле намеренно: правила для телефона (max-width:899px) задают
     `.hero-coach { top: … }` ниже по каскаду, и при той же специфичности победило бы то,
     что написано позже. Со «уменьшить движение» сцена не едет, поэтому копия и не уезжает:
     `paint` ставит open=1 сразу, и `.hero.open` прятал H1, лид и кнопку — на первом экране
     оставались только стоящая машина и карточка «Готово». Карточка при этом переезжает вниз,
     к телеметрии, иначе ложится прямо на заголовок. */
  @media (prefers-reduced-motion: reduce) {
    .hero.open .hero-copy {
      opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%);
    }
    /* Затемнение остаётся вместе с копией: `.hero.open` гасит его, и лид с подписью легли
       прямо на машины и на линию траектории — геометрически ничего не перекрывалось, а
       читать было нельзя. Границы градиента `park.js` считает по реальному низу копии. */
    .hero.open .hero-scrim { opacity: 1; }
    .hero-coach { top: auto; bottom: calc(clamp(22px, 3.5vh, 38px) + 56px); }
  }
</style>

<script>
  import { mount } from '../scripts/park.js';
  const hero = document.getElementById('hero');
  if (hero) mount(hero);

  /* Ролики грузятся, только когда доезжаешь до них, и останавливаются за экраном:
     preload="none" плюс IntersectionObserver — страница открывается без их веса. */
  const clips = document.querySelectorAll('video.clip');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (clips.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((rows) => {
      for (const r of rows) {
        const v = r.target;
        if (!r.isIntersecting) { v.pause(); continue; }
        /* preload включаем ЗДЕСЬ: выставленный заранее, он тянет оба ролика при
           открытии страницы и preload="none" в разметке уже ничего не значит */
        if (v.preload !== 'auto') v.preload = 'auto';
        v.play().catch(() => {});
      }
    }, { rootMargin: '120px 0px', threshold: 0.25 });
    for (const v of clips) io.observe(v);
  }
</script>
