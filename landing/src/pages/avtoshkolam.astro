---
import Base from '../layouts/Base.astro';

const gives = [
  {
    h: 'Домашняя отработка',
    p: 'Ученик гоняет параллельную парковку и эстакаду между занятиями, с телефона. На площадке вы шлифуете, а не учите с нуля.',
  },
  {
    h: 'Процент сдачи',
    p: 'МВД вводит публичный рейтинг школ по проценту сдачи. Экзаменационный режим считает те же штрафные баллы, что и инспектор.',
  },
  {
    h: 'Ваш бренд',
    p: 'White-label: страница с логотипом школы и вашим списком упражнений. Ссылку инструктор кидает в чат группы.',
  },
  {
    h: 'Ничего не внедрять',
    p: 'Нет оборудования, установки и обучения персонала. Работает на любом телефоне и компьютере, офлайн после первого открытия.',
  },
];
---
<Base
  page="schools"
  title="Тренажёр манёвров для автошколы — «По зеркалам»"
  description="Тренажёр парковки и экзаменационных манёвров для учеников автошколы: домашняя отработка между занятиями, экзаменационный режим с баллами по регламенту, white-label. Без оборудования и установки."
>
  <div class="wrap page-head">
    <h1>Аппаратный тренажёр стоит 214 000 ₽ и занимает класс</h1>
    <p class="lead">«По зеркалам» работает в браузере на телефоне ученика и стоит как пара
      учебных часов в месяц.</p>
    <div class="cta-row">
      <a class="btn lg" href="mailto:eeper03@mail.ru?subject=Тренажёр для автошколы">Обсудить пилот</a>
    </div>
    <p class="cta-note">Ответим на письмо и покажем демо на вашей группе.</p>
  </div>

  <section>
    <div class="wrap">
      <h2>Что получает школа</h2>
      <div class="cols">
        {gives.map((g) => (
          <div><h3>{g.h}</h3><p>{g.p}</p></div>
        ))}
      </div>

      <div class="card kerb sched">
        <p><b>Условия пилота.</b> Первым школам — бесплатный пилот на группу: даёте ученикам
          ссылку, вместе смотрим на цифры прохождений. Дальше фиксированная подписка на школу,
          без оплаты «за место».</p>
        <p><a href="mailto:eeper03@mail.ru?subject=Пилот тренажёра для автошколы">Написать нам</a></p>
      </div>

      <figure class="shot">
        <img src="/shots/parallel.webp" width="2000" height="1250" loading="lazy" decoding="async"
             alt="Параллельная парковка в тренажёре: габаритная рамка, зазоры до соседних машин и подсказка «Руль вправо до упора»." />
        <figcaption>Тот же манёвр, что на площадке: подсказка ведёт по точкам, зазоры видно в цифрах.</figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  .sched { margin-top: clamp(30px, 4vw, 46px); max-width: 64ch; }
  .sched p { color: var(--mute); }
  .sched p:last-child { margin-bottom: 0; }
  .shot { margin: clamp(34px, 4.6vw, 60px) 0 0; }
  .shot img { border-radius: 14px; border: 1px solid var(--edge); background: var(--asphalt-2); }
  .shot figcaption { margin-top: 12px; color: var(--faint); font-size: .87rem; max-width: 62ch; }
</style>
