# /etc/pozerkalam-account.env на vdsina (root:root 600). Деплой создаёт его один раз с новым
# JWT_SECRET и пустыми ключами; ключи провайдеров кладутся руками (docs/ACCOUNT.md).
JWT_SECRET=<openssl rand -base64 48>
# VK ID: id.vk.com/about/business → приложение Web, доверенный redirect = OAUTH_CALLBACK_URL
VK_CLIENT_ID=
# Яндекс ID: oauth.yandex.ru → «Веб-сервисы», redirect = OAUTH_CALLBACK_URL, доступ login:info
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://pozerkalam.space/api/v1/auth/callback
# debug — первые недели после включения входа, потом info
LOG_LEVEL=debug

# Необязательные — значения по умолчанию верны для прода; переопределяют их тесты и отладка.
# ACCT_PORT=8788                                    порт на 127.0.0.1, его ждёт nginx
# ACCT_DB=/var/lib/pozerkalam-account/account.db    по умолчанию $STATE_DIRECTORY/account.db
# PLAY_URL=https://pozerkalam.space/play/           куда возвращать после входа (#auth=<sid>)
# VK_BASE=https://id.vk.ru                          адреса провайдеров; тест подставляет заглушку
# YA_OAUTH_BASE=https://oauth.yandex.ru
# YA_LOGIN_BASE=https://login.yandex.ru
# ACCESS_TTL=3600                                   жизнь access, с
# REFRESH_TTL=7776000                               жизнь сессии от входа, с (90 суток)
# PENDING_TTL=600                                   сколько ждать возврата с входа, с
# PROVIDER_TIMEOUT=10                               таймаут запроса к VK/Яндексу, с
# TRUST_X_REAL_IP=1                                 IP игрока из заголовка nginx; 0 — только если сервис слушает не за nginx
